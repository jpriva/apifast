# Variables for running apifast from the source with tools/dev.sh
# (docs/14-desarrollo.md). Copy it to .env, which git ignores, and change it:
#
#   cp .env.example .env
#
# KEY=VALUE per line; # starts a comment. A variable already set in the shell
# wins over this file. Only tools/dev.sh reads it: an installed apifast does
# not.

# Where history, responses, sessions, the workspace and the vault's files go.
# Relative to the repository. Without it, the installed apifast's data
# (~/.local/share/apifast) is used and mixed with this one's.
APIFAST_DATA_DIR=target/dev/data

# Where settings.yml and keymap.yml go. Relative to the repository. Without
# it, the installed apifast's (~/.config/apifast).
APIFAST_CONFIG_DIR=target/dev/config

# 1: build optimized (cargo run --release). Slower to build, fast to use;
# like `tools/dev.sh --release`.
APIFAST_DEV_RELEASE=0

# The log (docs/14, "El registro"): a level for apifast's crates, or a
# filter in tracing's syntax (target=level, comma separated). It rules over
# the level setting. Libraries can log URLs at debug: use the level setting,
# or name apifast's crates, to see only apifast's.
#APIFAST_LOG=debug
#APIFAST_LOG=warn,apifast_gui=debug,apifast_http=trace

# Write to the terminal how long the first frame and the collection's tree
# took to show.
#APIFAST_TIMINGS=1

# Keep the vault's master key in a file under the data folder instead of the
# system keyring: for a throwaway data folder, so the keyring is not filled
# with test keys.
APIFAST_NO_KEYRING=1

# The interface's language when its setting says "the system's": en, es.
# LC_MESSAGES, not LANG: the shell always has LANG, and its value wins; the
# interface looks at LC_ALL, then LC_MESSAGES, then LANG.
#LC_MESSAGES=en_US.UTF-8

# Command line: opens the shared secrets of a collection without storing
# its key (the key your team gave you, AFK-…).
#APIFAST_COLLECTION_KEY=
